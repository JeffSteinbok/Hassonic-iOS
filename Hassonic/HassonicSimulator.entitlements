<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<!-- CarPlay. Apple grants CarPlay entitlements per-app on request, and no
	     device provisioning profile can carry this one until they do, so it is
	     scoped to simulator builds where entitlements are not validated.
	     Move it into Hassonic.entitlements once/if Apple approves.
	     Parking is the category that unlocks CPPointOfInterestTemplate. The
	     navigation entitlement (carplay-maps) would let us draw the whole
	     screen ourselves, but CPMapTemplate crash-loops the simulator's
	     CarPlay host — see docs/carplay.md. -->
	<key>com.apple.developer.carplay-parking</key>
	<true/>
</dict>
</plist>
